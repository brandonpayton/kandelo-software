+static void
+closeOpenDir(void)
+{
+#if defined(__wasm32__) && defined(HAVE_DIRENT_H)
+  /*
+   * The wasm32 musl directory stream can trip malloc's free() integrity checks
+   * after Squeak's repeated cached directory scans. Closing the fd keeps the
+   * kernel handle table healthy; intentionally leak the tiny DIR allocation.
+   */
+  if (openDir)
+    close(dirfd(openDir));
+#else
+  if (openDir)
+    closedir(openDir);
+#endif
+  openDir= 0;
+}
